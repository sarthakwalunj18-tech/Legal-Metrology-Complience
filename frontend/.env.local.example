# Frontend environment.
#
# Copy to `.env.local`. Every value here is read on the SERVER ONLY
# (Next.js route handlers and server components). Never prefix anything with
# NEXT_PUBLIC_ — the browser must not be able to reach the API origin, and no
# secret may ever be inlined into the client bundle.
#
# There are deliberately NO secret variables in this file. Supabase keys and the
# Gemini API key live exclusively in `backend/.env`.

# Origin of the Fastify API, used by the BFF route handlers.
# Local development default: http://localhost:8000
BACKEND_URL=http://localhost:8000

# Port the Next.js dev/prod server binds to.
PORT=3000