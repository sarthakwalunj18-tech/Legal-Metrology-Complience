# ---------------------------------------------------------------------------
# Legal Metrology Compliance Platform - Backend environment template
# Copy to `.env` and fill in real values. NEVER commit a filled-in `.env`.
# All variables below are server-side only; nothing here may be prefixed with
# NEXT_PUBLIC_ (those are inlined into the browser bundle by Next.js).
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=8000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- HTTP / CORS -----------------------------------------------------------
# Comma separated allow-list of browser origins. Wildcards are rejected in production.
CORS_ORIGIN=http://localhost:3000
# Absolute origin used to build evidence/report links handed to the browser.
# Defaults to the first CORS_ORIGIN entry when omitted.
# PUBLIC_API_URL=http://localhost:8000

# --- Database (PostgreSQL + pgvector, via Supabase or docker-compose) ------
DATABASE_URL=postgresql://postgres:postgrespassword@127.0.0.1:5432/postgres
DATABASE_POOL_MAX=5

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
# Browser-safe anon key (server-side use only in this project).
SUPABASE_ANON_KEY=
# Service role key. SERVER ONLY. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=commodity-scans

# --- AI / RAG --------------------------------------------------------------
# Google Gemini API key. SERVER ONLY. Leave blank to run the deterministic
# rule engine without LLM extraction/RAG embeddings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Demo / development authentication -------------------------------------
# Enables the role-based demo login and the `dev-inspector` / `dev-supervisor` /
# `dev-admin` bearer tokens. The server FORCES this off when NODE_ENV=production
# and refuses to boot if it is enabled there.
ALLOW_DEV_AUTH=true

# --- Uploads ---------------------------------------------------------------
UPLOAD_MAX_BYTES=20971520
UPLOAD_MAX_FILES=6
BODY_LIMIT_BYTES=2097152

# --- Rate limiting (fixed window, per client + route) ----------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_STANDARD=240
RATE_LIMIT_AUTH=10
RATE_LIMIT_AI=20

# --- Evidence media --------------------------------------------------------
# HMAC secret (>=16 chars) signing locally stored evidence image URLs.
# REQUIRED in production — the server refuses to boot without it.
# In development it is generated once and cached in `.media-signing-dev.key`
# (git-ignored) so local processes agree and dev links survive a restart.
MEDIA_SIGNING_SECRET=
MEDIA_URL_TTL_SECONDS=900

# --- Inspection pipeline ---------------------------------------------------
ANALYSIS_TIMEOUT_MS=120000
